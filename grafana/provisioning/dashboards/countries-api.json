      "datasource": { "type": "prometheus", "uid": "ffekqyjc6mpdsc" },
      "description": "Percentage of requests returning 5xx over the last 5 minutes",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "unit": "percent",
